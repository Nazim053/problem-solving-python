n = int(input())
m = int(input())
count = 0

for i in range (1, n):
    for j in range (1, n):
        for q in range (1, n):
            if ( i + ( 3 * j )+ ( 2 * q ) == m):
                count +=1
                print(f'{i} + 3×{j} + 2×{q} = {m}')

if (count == 0):
    print('При заданных n и m решений не существует.')            
